# Copy this to .env and fill in values for production
# Database
DATABASE_URL=

# JWT
JWT_SECRET=

# Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Frontend URL (Vercel)
FRONTEND_URL=

# S3 (optional) - if using S3, set these
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
